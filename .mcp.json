{
  "mcpServers": {
    "nornir-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "nornir-mcp-server",
        "python3",
        "-u",
        "server_stdio.py"
      ]
    },
    "memory-mcp": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-u",
        "nornir_mcp/memory_mcp/server_stdio.py"
      ]
    }
  }
}
